# Copy to .env and fill in. NEVER commit .env, never paste keys in a chat.

# mock = offline deterministic broker (default, no account needed)
# alpaca = free Alpaca paper-trading account
TRADING_BROKER=mock

# Free paper account: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# iex = free real-time feed included with a paper account
ALPACA_FEED=iex

# Where JSONL logs land (defaults to ./logs)
TRADING_LOG_DIR=./logs

# --- LLM providers (tool-calling harness, then the decision loop) -------------
# ollama (local, free) or opencode-go, or any OpenAI-compatible endpoint
LLM_PROVIDER=ollama
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
